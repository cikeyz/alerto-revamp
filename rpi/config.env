# ALERTO hub settings. setup.sh installs this as /etc/commuter-density.env
# After editing /etc/commuter-density.env:  sudo systemctl restart density-web
# Keep comments on their own lines and quote every value (read by systemd and bash).

# --- Wi-Fi hotspot (the ESP32 and commuters' phones join this) ---
HOTSPOT_SSID="CommuterDensity"
# Empty = open network (best for a public captive portal). For WPA2 use 8+ characters.
HOTSPOT_PASS=""
PORTAL_IP="10.42.0.1"
# The dashboard is also reachable as http://alerto.lan
PORTAL_NAME="alerto.lan"

# --- First-run defaults. After setup, change these in the dashboard's Settings tab ---
STATION_NAME="Central Station"
LINE_NAME="Line 1"
# % of floor occupied where Moderate and High start
MODERATE_AT="40"
CROWDED_AT="75"

# --- Sensor processing ---
# Minimum peak height in mm for an occupied group; 0 disables the peak filter.
# MIN_PEAK_MM="700"

# --- Security: CHANGE BOTH ---
# Must match NODE_KEY in every sensor ESP32 sketch
DEVICE_KEY="change-me-device-key"
# Staff PIN for the Settings tab and recalibration; empty = settings can't be changed
ADMIN_PIN=""

